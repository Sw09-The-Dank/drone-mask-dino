# Allow selecting the base image at build time so the Dockerfile works
# on different host architectures (amd64 for CUDA GPU images, arm64/CPU
# images for non-GPU platforms). Override with `--build-arg BASE_IMAGE=...`.
ARG BASE_IMAGE=nvidia/cuda:13.1.1-devel-ubuntu24.04
ARG TARGETPLATFORM
ARG TARGETARCH
# Allow overriding the Miniconda installer for different CPU architectures
ARG CONDA_INSTALLER_URL=https://repo.anaconda.com/miniconda/Miniconda3-py38_4.9.2-Linux-x86_64.sh
ARG INSTALL_CUDA_TOOLKIT=1
ARG CUDA_VERSION=13.1
# Ensure the base image is pulled for the requested target platform so buildx
# doesn't default to an amd64 variant on arm64 hosts.
FROM --platform=${TARGETPLATFORM} ${BASE_IMAGE}

# Re-declare build args so they're available after the FROM instruction
ARG BASE_IMAGE
ARG TARGETPLATFORM
ARG TARGETARCH
ARG INSTALL_CUDA_TOOLKIT
ARG CUDA_VERSION
ARG CONDA_INSTALLER_URL

ENV DEBIAN_FRONTEND=noninteractive
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/usr/local/cuda/lib64
ENV CUDA_HOME=/usr/local/cuda
ENV TORCH_CUDA_ARCH_LIST="13.1;13.0;12.1+PTX;8.6;8.0;7.5"
SHELL ["/bin/bash", "-lc"]
WORKDIR /workspace

# Copy requirements for caching
COPY requirements.txt /workspace/requirements.txt
COPY MaskDINO/requirements.txt /workspace/MaskDINO-requirements.txt

# Minimal system deps for runtime
# Remove NVIDIA/CUDA apt lists (they cause NO_PUBKEY errors in some base images),
# then install minimal packages.
RUN set -eux; \
    echo "Building on target platform: ${TARGETPLATFORM:-local} (${TARGETARCH:-unknown}) using base image: ${BASE_IMAGE:-unknown}"; \
    rm -f /etc/apt/sources.list.d/cuda* /etc/apt/sources.list.d/nvidia* || true; \
    apt-get update && apt-get install -y --no-install-recommends \
        wget bzip2 ca-certificates libgl1 gnupg dirmngr git build-essential cmake python3-dev ninja-build \
        pkg-config libhdf5-dev && \
    if [ "${INSTALL_CUDA_TOOLKIT:-0}" = "1" ] && [ "${TARGETARCH:-}" = "arm64" ]; then \
        # Run CUDA toolkit install in a tolerant subshell: failures here are non-fatal
        ( \
            set +e; \
            echo "Installing CUDA toolkit ${CUDA_VERSION} for arm64"; \
            wget -qO /tmp/cuda-keyring.deb https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2204/aarch64/cuda-keyring_1.0-1_all.deb; \
            dpkg -i /tmp/cuda-keyring.deb || echo "Warning: dpkg -i cuda-keyring failed; continuing"; \
            rm -f /tmp/cuda-keyring.deb; \
            apt-get update || echo "apt-get update failed after adding cuda keyring; continuing"; \
            apt-get install -y --no-install-recommends cuda-toolkit-$(echo ${CUDA_VERSION} | tr '.' '-') || \
            echo "CUDA toolkit ${CUDA_VERSION} not available via apt for this architecture; skipping install"; \
        ); \
    fi; \
    rm -rf /var/lib/apt/lists/*

# Install Miniconda (skip if already present in base image)
ENV CONDA_DIR=/opt/conda
RUN set -eux; \
    # Choose architecture-appropriate Miniconda installer when needed. If the
    # user provided an explicit CONDA_INSTALLER_URL, prefer it unless it points
    # to an x86_64 binary while building for arm64.
    installer="${CONDA_INSTALLER_URL}"; \
    if [ "${TARGETARCH:-}" = "arm64" ] && echo "${installer}" | grep -q "x86_64"; then \
        installer="https://repo.anaconda.com/miniconda/Miniconda3-py38_4.9.2-Linux-aarch64.sh"; \
    fi; \
    if [ ! -d "${CONDA_DIR}" ]; then \
        wget -qO /tmp/miniconda.sh "${installer}"; \
        bash /tmp/miniconda.sh -b -p "${CONDA_DIR}"; \
        rm /tmp/miniconda.sh; \
    else \
        echo "Conda already installed at ${CONDA_DIR}, skipping install"; \
    fi; \
    "${CONDA_DIR}"/bin/conda clean -ya || true

# Create runtime env and install Python deps (MaskDINO + repo requirements)
RUN set -eux; \
    ${CONDA_DIR}/bin/conda create -y -n maskdino python=3.8

RUN set -eux; \
    echo "Upgrading pip/setuptools/wheel in maskdino env"; \
    ${CONDA_DIR}/bin/conda run -n maskdino pip install --upgrade pip setuptools wheel

# Install CUDA-enabled PyTorch early so dependent packages pick up a GPU-enabled
# torch and do not replace it later.
RUN set -eux; \
    echo "Installing CUDA-enabled PyTorch (GPU) into maskdino env"; \
    # Prefer known-working wheel for manylinux aarch64 (cu130), then fall back
    CANDIDATES=("13.0" "${CUDA_VERSION}" "12.1"); \
    TORCH_VERSION="1.9.0"; TV_VERSION="0.10.0"; TA_VERSION="2.2.0"; \
    success=0; \
    for ver in "${CANDIDATES[@]}"; do \
        case "${ver}" in \
            13.1*) IDX="https://download.pytorch.org/whl/cu131" ;; \
            13.0*) IDX="https://download.pytorch.org/whl/cu130" ;; \
            12.1*) IDX="https://download.pytorch.org/whl/cu121" ;; \
            *) IDX="https://download.pytorch.org/whl/cu131" ;; \
        esac; \
        echo "Trying PyTorch wheels for CUDA ${ver} (index ${IDX})"; \
        if ${CONDA_DIR}/bin/conda run -n maskdino conda install -y -c pytorch -c nvidia pytorch==1.9.0 torchvision==0.10.0 cudatoolkit=11.1; then \
            echo "Successfully installed torch wheel for CUDA ${ver}"; success=1; break; \
        fi; \
        echo "pip wheel install failed for CUDA ${ver}, trying next candidate"; \
    done; \
    if [ "${success}" -ne 1 ]; then \
        echo "ERROR: Could not install a CUDA-enabled PyTorch for any candidate CUDA versions (${CANDIDATES[*]}); refusing to continue"; \
        exit 1; \
    fi

# Note: we postpone ensuring a CUDA-enabled PyTorch until after installing
# repo requirements so that pip/requirements don't overwrite the GPU wheel.

RUN set -eux; \
    echo "Installing opencv-python"; \
    ${CONDA_DIR}/bin/conda run -n maskdino pip install --no-cache-dir -U opencv-python

RUN set -eux; \
    echo "Installing repo Python requirements"; \
    ${CONDA_DIR}/bin/conda run -n maskdino pip install --no-cache-dir -r /workspace/requirements.txt -r /workspace/MaskDINO-requirements.txt; \
    echo "Pinning pillow and scikit-image for compatibility"; \
    ${CONDA_DIR}/bin/conda run -n maskdino python -m pip install --no-cache-dir 'pillow==9.4.0' 'scikit-image==0.20.0'; \
    \
    echo "Installing detectron2 from source to match PyTorch/CUDA"; \
    ${CONDA_DIR}/bin/conda run -n maskdino pip install --no-cache-dir 'git+https://github.com/facebookresearch/detectron2.git'

# Use the conda env Python by default
ENV PATH=${CONDA_DIR}/envs/maskdino/bin:${PATH}
ENV CONDA_DEFAULT_ENV=maskdino

# Copy repository (demo expects MaskDINO/ and configs present)
COPY . /workspace


# NOTE: Building CUDA extensions inside the image can fail when the build
# toolchain or CUDA target list doesn't match the host GPU / driver.
# We skip compiling the MultiScaleDeformableAttention op at image-build time.
# To compile it later (inside the container where nvcc/toolchain are available),
# run `/workspace/build_ops.sh` after starting the container and ensuring
# the host's CUDA toolkit is accessible.
COPY build_ops.sh /workspace/build_ops.sh
RUN chmod +x /workspace/build_ops.sh

# Try compiling CUDA ops during image build (non-fatal). If it fails,
# the container can build at runtime using /workspace/build_ops.sh.
RUN set -eux; \
    echo "Attempting to compile CUDA ops at image build time (may fail)"; \
    # Ensure CUDA paths are exported inside the conda-run subshell so nvcc is visible
    ${CONDA_DIR}/bin/conda run -n maskdino bash -lc "export CUDA_HOME=/usr/local/cuda && export PATH=/usr/local/cuda/bin:$PATH && /workspace/build_ops.sh" || echo "build_ops.sh failed during image build; will compile at runtime if needed"

# Default command: run the MaskDINO demo script. Override with container args if needed.
CMD ["/opt/conda/envs/maskdino/bin/python","MaskDINO/demo/demo.py","--config-file","/workspace/MaskDINO/configs/coco/instance-segmentation/maskdino_R50_bs16_50ep_3s.yaml"]
